[Unit]
Description=Robheroes Game Server
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=robheroes
Group=robheroes
WorkingDirectory=/var/www/robheroes
EnvironmentFile=/var/www/robheroes/.env.production
ExecStart=/usr/bin/node_modules/.bin/next start -p 3000
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=robheroes

[Install]
WantedBy=multi-user.target